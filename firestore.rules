rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per client invite, created by hand: review_tokens/{token} { active: true }
    // get is allowed (to validate a known token), list is not (tokens can't be enumerated).
    match /review_tokens/{token} {
      allow get: if true;
      allow list, write: if false;
    }

    match /testimonials/{id} {
      // Public carousel only sees approved testimonials.
      allow read: if resource.data.approved == true;

      // Create only with a valid active token, always pending, bounded fields.
      allow create: if
        exists(/databases/$(database)/documents/review_tokens/$(request.resource.data.token))
        && get(/databases/$(database)/documents/review_tokens/$(request.resource.data.token)).data.active == true
        && request.resource.data.keys().hasOnly(['name', 'jobTitle', 'rating', 'comment', 'token', 'approved', 'createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 80
        && request.resource.data.comment is string && request.resource.data.comment.size() >= 1 && request.resource.data.comment.size() <= 600;

      // Approve/delete from the Firebase console only.
      allow update, delete: if false;
    }
  }
}
